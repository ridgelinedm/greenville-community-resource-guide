---
/**
 * Sticky header: logo + region | centered menus (a two-column "Find help"
 * panel) | Get help now. Below 1080px the menus collapse into a toggle.
 * Source: design system components/navigation/SiteHeader.jsx.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { link, stripBase } from '../utils/url';
import { SITE_SUBTITLE } from '../consts';

const path = stripBase(Astro.url.pathname);
const isActive = (href: string) => path.startsWith(href);

const situations = [
  { href: '/get-help-now', icon: 'alert', title: 'I need help right now', text: 'Crisis lines and a safe place tonight', urgent: true },
  { href: '/someone-i-love-is-in-jail', icon: 'family', title: 'Someone I love is in jail', text: 'Find them, reach them, help your family' },
  { href: '/reentry-support', icon: 'reentry', title: "I'm coming home, or just got out", text: 'ID, a place to stay, food and work' },
];
const needs = [
  { href: '/housing-shelter', icon: 'housing', title: 'A place to stay' },
  { href: '/food-assistance', icon: 'food', title: 'Food' },
  { href: '/financial-assistance', icon: 'financial', title: 'Rent or bills' },
  { href: '/medical-care', icon: 'medical', title: 'A doctor or medicine' },
  { href: '/mental-health-recovery', icon: 'mental-health', title: 'Someone to talk to' },
  { href: '/legal-aid', icon: 'legal', title: 'Legal help' },
];
const links = [
  { href: '/resources', label: 'All organizations' },
  { href: '/about', label: 'About this guide' },
];
---

<header class="site-header">
  <div class="container hdr2">
    <a href={link('/')} class="brand" aria-label={`A Place to Turn, ${SITE_SUBTITLE}, home`}>
      <Logo size={24} />
      <span class="brand-where" aria-hidden="true">{SITE_SUBTITLE}</span>
    </a>

    <ul class="hdr2-menus">
      <li>
        <button type="button" class="hdr2-trigger" aria-expanded="false" aria-controls="find-panel" data-menu-trigger>
          Find help <Icon name="chevron-right" size={15} />
        </button>
      </li>
      {
        links.map((l) => (
          <li>
            <a
              href={link(l.href)}
              class:list={['hdr2-trigger', { 'is-active': isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hdr2-actions">
      <a href={link('/get-help-now')} class="btn btn-primary hdr2-now">Get help now</a>
      <button type="button" class="hdr2-toggle" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle>
        <span data-icon-open><Icon name="menu" size={22} /></span>
        <span data-icon-close hidden><Icon name="x" size={22} /></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>

    <div class="hdr2-panel" id="find-panel" hidden>
      <div class="hdr2-col">
        <p class="hdr2-col-h">What's happening?</p>
        <ul>
          {
            situations.map((s) => (
              <li>
                <a href={link(s.href)} class:list={['hdr2-item', { 'hdr2-item-urgent': s.urgent }]}>
                  <span class="hdr2-item-icon"><Icon name={s.icon} size={18} /></span>
                  <span>
                    <span class="hdr2-item-t">{s.title}</span>
                    <span class="hdr2-item-s">{s.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hdr2-col">
        <p class="hdr2-col-h">What you need</p>
        <ul>
          {
            needs.map((n) => (
              <li>
                <a href={link(n.href)} class="hdr2-simple"><Icon name={n.icon} size={18} />{n.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hdr2-panel-foot">
        <span>Not sure which one fits?</span>
        <button type="button" class="tlink" data-guide-open aria-haspopup="dialog">Answer 3 quick questions</button>
      </div>
    </div>
  </div>

  <div class="hdr2-mobile" id="mobile-menu" hidden>
    <div class="hdr2-col">
      <p class="hdr2-col-h">What's happening?</p>
      <ul>
        {
          situations.map((s) => (
            <li>
              <a href={link(s.href)} class:list={['hdr2-item', { 'hdr2-item-urgent': s.urgent }]}>
                <span class="hdr2-item-icon"><Icon name={s.icon} size={18} /></span>
                <span>
                  <span class="hdr2-item-t">{s.title}</span>
                  <span class="hdr2-item-s">{s.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hdr2-col">
      <p class="hdr2-col-h">What you need</p>
      <ul>
        {
          needs.map((n) => (
            <li>
              <a href={link(n.href)} class="hdr2-simple"><Icon name={n.icon} size={18} />{n.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
    {links.map((l) => <a href={link(l.href)} class="hdr2-simple">{l.label}</a>)}
    <button type="button" class="tlink" data-guide-open aria-haspopup="dialog">Not sure what you need? Answer 3 quick questions</button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const trigger = header?.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const panel = document.getElementById('find-panel');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const mobile = document.getElementById('mobile-menu');

  const setPanel = (open: boolean) => {
    if (!trigger || !panel) return;
    panel.hidden = !open;
    trigger.setAttribute('aria-expanded', String(open));
  };
  const setMobile = (open: boolean) => {
    if (!toggle || !mobile) return;
    mobile.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector<HTMLElement>('[data-icon-open]')!.hidden = open;
    toggle.querySelector<HTMLElement>('[data-icon-close]')!.hidden = !open;
  };

  trigger?.addEventListener('click', () => setPanel(panel?.hidden ?? false));
  toggle?.addEventListener('click', () => setMobile(mobile?.hidden ?? false));
  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node)) setPanel(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (panel && !panel.hidden) {
      setPanel(false);
      trigger?.focus();
    }
    setMobile(false);
  });
</script>
