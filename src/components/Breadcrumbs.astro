---
import Icon from './Icon.astro';
import JsonLd from './JsonLd.astro';
import { link, absolute } from '../utils/url';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const origin = Astro.site?.origin ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: absolute(origin, c.href) } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((c, i) => (
        <li>
          {c.href ? <a href={link(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          {i < items.length - 1 && <Icon name="chevron-right" size={14} class="sep" />}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd schema={schema} />

