---
/**
 * Action card: answers "what can this place do for me, and what do I do next?"
 * The next step is always the most prominent thing on the card.
 */
import Icon from './Icon.astro';
import { getCategory, NEXT_STEP_BY_CATEGORY, type CategoryKey, type Resource } from '../data/resources';
import { link } from '../utils/url';

interface Props {
  resource: Resource;
  /** Category context (e.g. the hub/intent page) shown first in the chip row. */
  contextCategory?: string;
  /** Heading level for the organization name, so cards nest correctly on every page. */
  headingLevel?: 'h2' | 'h3' | 'h4';
}
const { resource, contextCategory, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const next = resource.nextStep;
// On a category page, phrase the call around that need ("ask if they have space")
// unless this organization has its own wording.
const nextText =
  next && next.kind === 'call' && !next.custom && contextCategory
    ? NEXT_STEP_BY_CATEGORY[contextCategory as CategoryKey] ?? next.text
    : next?.text;
const external = next?.kind !== 'call';
const nextIcon = next?.kind === 'call' ? 'phone' : next?.kind === 'directions' ? 'map-pin' : 'external';

// Order chips so the page's category appears first.
const cats = [...resource.categories].sort((a, b) =>
  a === contextCategory ? -1 : b === contextCategory ? 1 : 0
);
---

<article class="rcard">
  <div class="rcard-body">
    <div class="rcard-tags">
      {
        cats.slice(0, 2).map((c) => {
          const cat = getCategory(c);
          return cat ? (
            <span class:list={['chip', 'chip-sage', { 'chip-on': c === contextCategory }]}>
              <Icon name={cat.icon} size={14} />
              {cat.nav ?? cat.label}
            </span>
          ) : null;
        })
      }
    </div>

    <Heading class="rcard-name">
      <a href={link(`/resource/${resource.slug}`)}>{resource.name}</a>
    </Heading>

    <dl class="rcard-facts">
      {
        resource.description && (
          <div>
            <dt>What they help with</dt>
            <dd>{resource.description}</dd>
          </div>
        )
      }
      {
        resource.whoFor && (
          <div>
            <dt>Who it's for</dt>
            <dd>{resource.whoFor}</dd>
          </div>
        )
      }
      {
        resource.hours && (
          <div>
            <dt>Hours</dt>
            <dd>{resource.hours}</dd>
          </div>
        )
      }
      {
        resource.address && (
          <div>
            <dt>Where</dt>
            <dd>{resource.address}</dd>
          </div>
        )
      }
      {
        resource.goodToKnow.length > 0 && (
          <div>
            <dt>Good to know</dt>
            <dd>
              {resource.goodToKnow.length === 1 ? (
                resource.goodToKnow[0]
              ) : (
                <ul>{resource.goodToKnow.map((n) => <li>{n}</li>)}</ul>
              )}
            </dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="rcard-next">
    {
      next ? (
        <>
          <p class="rcard-next-text">
            <strong>Next step:</strong> {nextText}
          </p>
          <a
            class="btn btn-primary rcard-cta"
            href={next.href}
            {...(external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <Icon name={nextIcon} size={18} /> {next.label}
            {external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </>
      ) : (
        <p class="rcard-next-text">
          <strong>Next step:</strong> We don't have contact details for this one yet. Call
          <a href="tel:211">211</a> and ask for it by name.
        </p>
      )
    }
    <a class="rcard-more" href={link(`/resource/${resource.slug}`)}>
      More about {resource.name}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</article>

