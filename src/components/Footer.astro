---
/**
 * Navy footer: logo + promise, link columns, disclaimer, and an oversized
 * wordmark sign-off. Source: design system components/navigation/SiteFooter.jsx.
 */
import Logo from './Logo.astro';
import { RESOURCES } from '../data/resources';
import { AREA } from '../consts';
import { link } from '../utils/url';

const year = new Date().getFullYear(); // stamped at build time

const cols: [string, [string, string][]][] = [
  [
    'Find help',
    [
      ['I need help right now', '/get-help-now'],
      ['Someone I love is in jail', '/someone-i-love-is-in-jail'],
      ["I'm coming home", '/reentry-support'],
      ['All organizations', '/resources'],
    ],
  ],
  [
    'What you need',
    [
      ['A place to stay', '/housing-shelter'],
      ['Food', '/food-assistance'],
      ['Rent or bills', '/financial-assistance'],
      ['A doctor or medicine', '/medical-care'],
      ['Someone to talk to', '/mental-health-recovery'],
      ['Legal help', '/legal-aid'],
    ],
  ],
  [
    'About',
    [
      ['About this guide', '/about'],
      ['How we check information', '/about#how-we-check'],
    ],
  ],
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <p class="footer-brand"><Logo tone="reversed" size={24} /></p>
      <p class="footer-tag">
        A free guide to help in {AREA}. Start with what is happening, and find a clear next
        step with {RESOURCES.length} local organizations.
      </p>
      <a href={link('/get-help-now')} class="btn btn-outline footer-help">Need help now?</a>
    </div>
    {
      cols.map(([title, items]) => (
        <nav class="footer-col" aria-label={title}>
          <h2 class="footer-h">{title}</h2>
          <ul>
            {items.map(([label, href]) => (
              <li>
                <a href={link(href)}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container footer-bottom">
    <p>
      © {year} A Place to Turn. This guide is provided for informational purposes. Always call
      ahead to confirm hours, eligibility, and availability. Services can change. In an
      emergency, call <a href="tel:911">911</a>.
    </p>
  </div>
  <div class="container">
    <p class="footer-sign" aria-hidden="true">a place to turn<span>.</span></p>
  </div>
</footer>
