---
/**
 * Crisis hotline panel (full / compact) or a one-line strip for list pages.
 * Source: design system components/help/CrisisLines.jsx.
 */
import Icon from './Icon.astro';
import { CRISIS_LINES } from '../consts';
import { link } from '../utils/url';

interface Props {
  /** 'strip' is a single line for list pages, so urgent numbers stay visible
   *  without pushing the resources below the fold. */
  variant?: 'full' | 'compact' | 'strip';
  title?: string;
}
const { variant = 'full', title = 'In crisis or in danger? Get help right now.' } = Astro.props;
---

{
  variant === 'strip' ? (
    <p class="note note-urgent">
      <Icon name="alert" size={18} />
      <span>
        <strong>In danger?</strong> Call <a href="tel:911">911</a>. <strong>In crisis?</strong> Call
        or text <a href="tel:988">988</a>.
        <a href={link('/get-help-now')} class="crisis-more">More crisis lines</a>
      </span>
    </p>
  ) : (
    <section class:list={['crisis', { compact: variant === 'compact' }]} aria-label="Emergency and crisis hotlines">
      <div class="crisis-head">
        <span class="crisis-icon" aria-hidden="true"><Icon name="alert" size={20} /></span>
        <p class="crisis-title">{title}</p>
      </div>
      <ul class="crisis-list">
        {CRISIS_LINES.map((line) => (
          <li>
            <a href={`tel:${line.tel}`} class="crisis-card">
              <span class="crisis-label">{line.label}</span>
              <span class="crisis-number">
                <Icon name="phone" size={16} /> {line.number}
              </span>
              <span class="crisis-note">{line.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
