---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { link } from '../utils/url';

const needs = [
  { href: '/get-help-now', icon: 'alert', label: 'I need help right now' },
  { href: '/someone-i-love-is-in-jail', icon: 'family', label: 'Someone I love is in jail' },
  { href: '/housing-shelter', icon: 'housing', label: 'I need a place to stay' },
  { href: '/food-assistance', icon: 'food', label: 'I need food' },
];
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container container-narrow">
      <h1>We couldn't find that page</h1>
      <p class="lead" style="margin-top:0.8rem;max-width:50ch">
        It may have moved, but the help you're looking for is still here. Search, or pick what's
        going on.
      </p>

      <form class="searchbar" action={link('/resources')} method="get" role="search" style="margin-top:1.75rem">
        <Icon name="search" size={22} class="searchbar-icon" />
        <label for="nf-q" class="sr-only">Search by need or organization name</label>
        <input id="nf-q" name="q" type="search" placeholder="Search a need or a name" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>

      <ul class="needs" style="margin-top:2rem">
        {
          needs.map((n) => (
            <li>
              <a href={link(n.href)} class="need">
                <span class="need-icon"><Icon name={n.icon} size={22} /></span>
                <span>{n.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
