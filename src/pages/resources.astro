---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResourceCard from '../components/ResourceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { RESOURCES, activeCategories, AUDIENCE_FILTERS, getCategory } from '../data/resources';
import { AREA } from '../consts';
import { link } from '../utils/url';

const cats = activeCategories();

// The search index is split into separate fields rather than one flat blob so
// each can be weighted. This matters most for `serves`: it's an eligibility
// list ("man woman couple veteran senior …"), not a description of what an org
// actually does. Indexed at full weight it made every come-one-come-all org
// match "veteran" or "domestic violence", burying the real specialists.
const items = RESOURCES.map((r) => ({
  resource: r,
  cats: r.categories.join(' '),
  auds: r.audiences.join(' '),
  name: r.name.toLowerCase(),
  catLabels: r.categories
    .map((c) => getCategory(c)?.label ?? '')
    .join(' ')
    .toLowerCase(),
  desc: (r.description ?? '').toLowerCase(),
  address: (r.address ?? '').toLowerCase(),
  serves: r.serves.join(' ').toLowerCase(),
}));

const title = `All organizations: search free help in ${AREA}`;
const description = `Search and filter all ${RESOURCES.length} community resources in Greenville County by need and situation — food, housing, medical care, mental health, and more.`;
---

<Base title={title} description={description}>
  <div class="container page-top">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'All organizations' }]} />
  </div>

  <section class="cat-head">
    <div class="container cat-head-inner">
      <span class="situation-icon" aria-hidden="true"><Icon name="book-open" size={30} /></span>
      <div>
        <h1>All organizations</h1>
        <p class="lead">
          Every organization in this guide, in one place. If you're not sure what you need, the
          <a href={link('/')}>homepage</a> is an easier place to start.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="dir-search-row">
        <div class="searchbar" role="search">
          <Icon name="search" size={22} class="searchbar-icon" />
          <label for="dir-q" class="sr-only">Search by need or organization name</label>
          <input id="dir-q" type="search" placeholder="Search a need or a name, like “shelter” or “Triune”" autocomplete="off" />
          <button type="button" id="dir-clear" class="btn btn-ghost" hidden>
            <Icon name="x" size={18} /><span class="sr-only">Clear search</span>
          </button>
        </div>
      </div>

      <div class="dir-filters">
        <p class="dir-filter-h">Type of help</p>
        <div class="filterbar filter-chips" data-group="category" role="group" aria-label="Type of help">
          {
            cats.map((c) => (
              <button class="filter fchip" data-value={c.key} type="button" aria-pressed="false">
                <Icon name={c.icon} size={16} />
                {c.label}
              </button>
            ))
          }
        </div>
        <p class="dir-filter-h">Who it's for</p>
        <div class="filterbar filter-chips" data-group="audience" role="group" aria-label="Who it's for">
          {
            AUDIENCE_FILTERS.map((a) => (
              <button class="filter fchip" data-value={a.key} type="button" aria-pressed="false">
                {a.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="list-bar">
        <p class="list-count" id="dir-count" aria-live="polite">Showing all {RESOURCES.length} organizations</p>
        <button type="button" id="dir-reset" class="btn btn-ghost" hidden>Clear filters</button>
      </div>

      <div class="grid grid-3" id="dir-results">
        {
          items.map((it) => (
            <div
              class="result rlist-item"
              data-cats={it.cats}
              data-auds={it.auds}
              data-name={it.name}
              data-catlabels={it.catLabels}
              data-desc={it.desc}
              data-address={it.address}
              data-serves={it.serves}
            >
              <ResourceCard resource={it.resource} />
            </div>
          ))
        }
      </div>

      <p id="dir-empty" class="note" hidden>
        <Icon name="info" size={18} />
        <span>
          Nothing matches that yet. Try fewer words or clear a filter. You can also call
          <a href="tel:211">211</a> and ask.
        </span>
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <CtaBand
        title="Didn't see the right one?"
        text="Call 211 and tell them what's going on. They'll point you to someone near you."
        secondary={null}
      />
    </div>
  </section>
</Base>

<script>
  import { rank, expand } from '../utils/search';
  const q = document.getElementById('dir-q') as HTMLInputElement;
  const clearBtn = document.getElementById('dir-clear') as HTMLButtonElement;
  const resetBtn = document.getElementById('dir-reset') as HTMLButtonElement;
  const countEl = document.getElementById('dir-count') as HTMLElement;
  const emptyEl = document.getElementById('dir-empty') as HTMLElement;
  const resultsEl = document.getElementById('dir-results') as HTMLElement;
  const results = Array.from(document.querySelectorAll<HTMLElement>('.result'));
  const total = results.length;

  const docs = results.map((el) => ({
    el,
    fields: {
      name: el.dataset.name || '',
      catlabels: el.dataset.catlabels || '',
      desc: el.dataset.desc || '',
      address: el.dataset.address || '',
      serves: el.dataset.serves || '',
    },
    cats: (el.dataset.cats || '').split(' ').filter(Boolean),
    auds: (el.dataset.auds || '').split(' ').filter(Boolean),
    ref: el,
  }));

  const state = { q: '', category: '', audience: '' };

  function apply() {
    const hits = rank(docs, state.q, { category: state.category, audience: state.audience });
    const querying = expand(state.q).length > 0;

    const show = new Set(hits.map((h) => h.doc.ref));
    for (const d of docs) d.el.hidden = !show.has(d.el);

    // Reorder the DOM so the best match is first — appending an existing node
    // moves it. With no query, fall back to the original authored order.
    const frag = document.createDocumentFragment();
    (querying ? hits.map((h) => h.doc.ref) : docs.map((d) => d.el)).forEach((el) =>
      frag.appendChild(el)
    );
    resultsEl.appendChild(frag);

    const shown = hits.length;
    const filtering = querying || state.category || state.audience;
    countEl.textContent = filtering
      ? `Showing ${shown} of ${total} organizations`
      : `Showing all ${total} organizations`;
    emptyEl.hidden = shown !== 0;
    resultsEl.hidden = shown === 0;
    clearBtn.hidden = !state.q;
    resetBtn.hidden = !filtering;
  }

  function syncUrl() {
    const p = new URLSearchParams();
    if (state.q) p.set('q', state.q);
    if (state.category) p.set('category', state.category);
    if (state.audience) p.set('audience', state.audience);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  q.addEventListener('input', () => {
    state.q = q.value;
    apply();
    syncUrl();
  });
  clearBtn.addEventListener('click', () => {
    q.value = '';
    state.q = '';
    q.focus();
    apply();
    syncUrl();
  });

  document.querySelectorAll<HTMLElement>('.filter-chips').forEach((group) => {
    const key = group.dataset.group as 'category' | 'audience';
    group.querySelectorAll<HTMLButtonElement>('.fchip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const val = chip.dataset.value || '';
        const isActive = state[key] === val;
        group.querySelectorAll('.fchip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
        state[key] = isActive ? '' : val;
        if (!isActive) chip.setAttribute('aria-pressed', 'true');
        apply();
        syncUrl();
      });
    });
  });

  resetBtn.addEventListener('click', () => {
    state.q = '';
    state.category = '';
    state.audience = '';
    q.value = '';
    document.querySelectorAll('.fchip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    apply();
    syncUrl();
  });

  // Initialize from URL (?q= / ?category= / ?audience=)
  (function init() {
    const p = new URLSearchParams(location.search);
    state.q = p.get('q') || '';
    // Ignore filter values with no matching chip (e.g. old links to a removed
    // group), so a stale link never shows an empty list with nothing to clear.
    const known = (group: string, value: string) =>
      Boolean(value && document.querySelector(`.filter-chips[data-group="${group}"] .fchip[data-value="${value}"]`));
    const cat = p.get('category') || '';
    const aud = p.get('audience') || '';
    state.category = known('category', cat) ? cat : '';
    state.audience = known('audience', aud) ? aud : '';
    q.value = state.q;
    if (state.category) {
      document
        .querySelector(`.filter-chips[data-group="category"] .fchip[data-value="${state.category}"]`)
        ?.setAttribute('aria-pressed', 'true');
    }
    if (state.audience) {
      document
        .querySelector(`.filter-chips[data-group="audience"] .fchip[data-value="${state.audience}"]`)
        ?.setAttribute('aria-pressed', 'true');
    }
    apply();
  })();
</script>
