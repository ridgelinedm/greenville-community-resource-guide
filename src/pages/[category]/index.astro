---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResourceList from '../../components/ResourceList.astro';
import CtaBand from '../../components/CtaBand.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CrisisLines from '../../components/CrisisLines.astro';
import {
  activeCategories,
  resourcesInCategory,
  spokesForAudience,
  getAudience,
  CATEGORIES,
  countInCategory,
  type Category,
} from '../../data/resources';
import { AREA_SHORT } from '../../consts';
import { link, absolute } from '../../utils/url';

export function getStaticPaths() {
  return activeCategories().map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const resources = resourcesInCategory(category.key);
const isCrisisCategory = category.key === 'mental-health' || category.key === 'housing';

// Population categories (Veterans, Youth, …) link out to matching intent pages
// across every service category — hub-and-spoke.
const spokeAudience = category.population ? getAudience(category.population) : undefined;
const spokes = category.population ? spokesForAudience(category.population) : [];

const others = CATEGORIES.filter((c) => c.key !== category.key && countInCategory(c.key) > 0);

const origin = Astro.site?.origin ?? '';
const title = `${category.label} in ${AREA_SHORT}`;
const description = `${category.intro} ${resources.length} local organizations, with phone numbers, addresses, and who they serve.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: category.intro,
  url: absolute(origin, `/${category.slug}`),
  about: category.label,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: resources.length,
    itemListElement: resources.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(origin, `/resource/${r.slug}`),
      name: r.name,
    })),
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="container page-top">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: category.label }]} />
  </div>

  <section class="cat-head">
    <div class="container cat-head-inner">
      <span class="situation-icon" aria-hidden="true"><Icon name={category.icon} size={30} /></span>
      <div>
        <h1>{category.heading}</h1>
        <p class="lead">{category.lead}</p>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-label={`${category.label} organizations`}>
    <div class="container">
      {isCrisisCategory && <div class="list-strip"><CrisisLines variant="strip" /></div>}
      <ResourceList resources={resources} contextCategory={category.key} excludeAudience={category.population} />
    </div>
  </section>

  {
    spokes.length > 0 && spokeAudience && (
      <section class="section-tight bg-soft" style="border-top:1px solid var(--line)">
        <div class="container">
          <SectionHeader
            title={`More help for ${spokeAudience.short}`}
            text={`Each page lists the places ready to help ${spokeAudience.short}.`}
          />
          <ul class="needs">
            {spokes.map((sp) => (
              <li>
                <a href={link(`/${sp.category.slug}/${sp.audience.slug}`)} class="need">
                  <span class="need-icon"><Icon name={sp.category.icon} size={22} /></span>
                  <span>{sp.category.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="container">
      <h2 style="font-size:1.35rem;margin-bottom:1rem">Other kinds of help</h2>
      <ul class="other-cats">
        {
          others.map((c) => (
            <li>
              <a href={link(`/${c.slug}`)} class="chip chip-sage">
                <Icon name={c.icon} size={15} />
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <CtaBand
        title="Didn't see the right one?"
        text="Call 211 and tell them what's going on. They'll point you to someone near you."
        secondary={null}
      />
    </div>
  </section>
</Base>
