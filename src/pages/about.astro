---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { PHOTOS } from '../data/photos';
import { RESOURCES } from '../data/resources';
import { link } from '../utils/url';
import { SITE_NAME, AREA } from '../consts';

const title = 'About this guide';
const description = `How ${SITE_NAME} works: a free guide to ${RESOURCES.length} community resources in ${AREA}, built so anyone can find help for their exact situation.`;
---

<Base title={title} description={description}>
  <div class="container page-top">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About this guide' }]} />
  </div>

  <section class="journey-head">
    <div class="container container-narrow">
      <h1>About this guide</h1>
      <p class="lead">
        {SITE_NAME} is a free guide for neighbors in {AREA}. You start with what is happening,
        and it helps you find a clear next step.
      </p>
      <Photo photo={PHOTOS.about} eager sizes="(min-width: 900px) 780px, 100vw" class="about-photo" />
    </div>
  </section>

  <div class="container container-narrow journey-body prose">
    <section class="journey-section">
      <h2>Why it's here</h2>
      <p>
        When something hard happens, you shouldn't have to dig through dozens of websites or
        know the name of an agency to get help. This guide brings
        <strong>{RESOURCES.length} local organizations</strong> into one place, and starts with
        your situation instead of a list of programs.
      </p>
    </section>

    <section class="journey-section">
      <h2>How to use it</h2>
      <ul>
        <li><strong>Start with what's happening.</strong> Pick the situation on the <a href={link('/')}>homepage</a> that sounds most like yours.</li>
        <li><strong>Look for the next step.</strong> Every organization shows one clear thing to do, usually a phone call.</li>
        <li><strong>Narrow it down</strong> by who it's for, like families, veterans, or people coming home.</li>
        <li><strong>Know a name already?</strong> Search <a href={link('/resources')}>all organizations</a>.</li>
      </ul>
    </section>

    <section class="journey-section" id="how-we-check">
      <h2>How we check information</h2>
      <p>
        We try never to present something we haven't confirmed. Where we don't know a detail,
        we say so. For example, "Hours are not listed here. Call before you go."
      </p>
      <p>
        The page for families of someone in jail was checked against official Greenville County
        and South Carolina websites on October 5, 2026. Each section says what to call and ask
        when a detail couldn't be confirmed.
      </p>
      <p>
        Services, hours, and rules change often. <strong>Always call ahead</strong> before you
        go. This guide is for information only and isn't legal, medical, or professional advice.
        In an emergency, call <a href="tel:911">911</a>.
      </p>
    </section>

    <section class="journey-section">
      <h2>Found something out of date?</h2>
      <p>
        If a phone number has changed or an organization is missing, please let us know so we
        can fix it. You can also call <a href="tel:211">211</a> any time to reach a real person
        who knows local resources.
      </p>
    </section>

    <section class="journey-section" id="photo-credits">
      <h2>Photo credits</h2>
      <p>
        The photos are real places in Greenville, shared on Wikimedia Commons under open
        licenses. Some are cropped to fit the page.
      </p>
      <ul class="credits">
        {
          Object.values(PHOTOS).map((p) => (
            <li>
              <a href={p.source}>{p.place}</a> by {p.author},{' '}
              <a href={p.licenseUrl}>{p.license}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="section-tight">
    <div class="container"><CtaBand /></div>
  </section>
</Base>
