---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, countInCategory, AUDIENCES } from '../data/resources';
import { SITE_NAME, SITE_DESCRIPTION, AREA } from '../consts';
import { link, absolute } from '../utils/url';

/**
 * Homepage = "what is happening?" first, directory second. The three
 * situations are the brief's signature journeys; needs are phrased the way
 * people describe their problem, each landing on its category hub.
 */
const situations = [
  {
    href: '/get-help-now',
    icon: 'alert',
    title: 'I need help right now',
    text: 'Crisis lines, a safe place tonight, and what to do first.',
    tone: 'urgent',
  },
  {
    href: '/someone-i-love-is-in-jail',
    icon: 'family',
    title: 'Someone I love was arrested or is in jail',
    text: 'Find where they are, how to reach them, and help for your family.',
    tone: 'journey',
  },
  {
    href: '/reentry-support',
    icon: 'reentry',
    title: "I'm getting ready to come home, or just got out",
    text: 'ID, a place to stay, food, work, and people who can help.',
    tone: 'journey',
  },
];

const needs = [
  { href: '/housing-shelter', icon: 'housing', label: 'I need a place to stay' },
  { href: '/food-assistance', icon: 'food', label: 'I need food' },
  { href: '/financial-assistance', icon: 'financial', label: 'I need help with rent or bills' },
  { href: '/medical-care', icon: 'medical', label: 'I need a doctor or medicine' },
  { href: '/mental-health-recovery', icon: 'mental-health', label: "I'm struggling, or want to stop drinking or using" },
  { href: '/legal-aid', icon: 'legal', label: 'I need legal help' },
  { href: '/transportation', icon: 'transportation', label: 'I need a way to get around' },
  { href: '/education', icon: 'education', label: 'I want school or job training' },
];

const browseCats = CATEGORIES.filter((c) => countInCategory(c.key) > 0);
const groups = AUDIENCES.filter((a) => !['men', 'women'].includes(a.key));

const origin = Astro.site?.origin ?? '';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute(origin, '/'),
    description: SITE_DESCRIPTION,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: absolute(origin, '/resources?q={search_term_string}'),
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: absolute(origin, '/'),
    description: SITE_DESCRIPTION,
    areaServed: { '@type': 'AdministrativeArea', name: AREA },
  },
];
---

<Base title={`${SITE_NAME}: Find help and your next step in Greenville, SC`} bareTitle jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">
        <Icon name="map-pin" size={15} /> {AREA}
      </p>
      <h1>Need help? Start here.</h1>
      <p class="lead hero-lead">
        You don't need to know who to call. Pick what's going on, and we'll show you what to
        do next. It's free, and you don't have to sign up.
      </p>
      <p class="hero-emergency">
        <strong>In danger right now?</strong> Call <a href="tel:911">911</a>. Thinking about
        hurting yourself? Call or text <a href="tel:988">988</a>, any time.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="situation-h">
    <div class="container">
      <h2 id="situation-h" class="home-h">What's happening?</h2>
      <ul class="situations">
        {
          situations.map((s) => (
            <li>
              <a href={link(s.href)} class:list={['situation', `situation-${s.tone}`]}>
                <span class="situation-icon"><Icon name={s.icon} size={26} /></span>
                <span class="situation-text">
                  <span class="situation-title">{s.title}</span>
                  <span class="situation-sub">{s.text}</span>
                </span>
                <Icon name="chevron-right" size={22} class="situation-arrow" />
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="home-h home-h-sub">Or tell us what you need</h2>
      <ul class="needs">
        {
          needs.map((n) => (
            <li>
              <a href={link(n.href)} class="need">
                <span class="need-icon"><Icon name={n.icon} size={22} /></span>
                <span class="need-label">{n.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight bg-soft" aria-labelledby="unsure-h">
    <div class="container">
      <div class="unsure">
        <div>
          <h2 id="unsure-h">Not sure where to start?</h2>
          <p>
            Call <strong>211</strong> any time, day or night. A real person will listen and point
            you to help near you. It's free and private.
          </p>
        </div>
        <a href="tel:211" class="btn btn-primary unsure-btn"><Icon name="phone" size={18} /> Call 211</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="search-h">
    <div class="container">
      <h2 id="search-h" class="home-h">Know what you're looking for?</h2>
      <form class="searchbar" action={link('/resources')} method="get" role="search">
        <label for="home-q" class="sr-only">Search by need or organization name</label>
        <Icon name="search" size={22} class="searchbar-icon" />
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="Search a need or a name, like “shelter” or “Triune”"
          autocomplete="off"
        />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>

      <div class="browse">
        <div>
          <h3 class="browse-h">Browse by type of help</h3>
          <ul class="browse-list">
            {browseCats.map((c) => <li><a href={link(`/${c.slug}`)}>{c.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h3 class="browse-h">Help for specific groups</h3>
          <ul class="browse-list">
            {groups.map((a) => <li><a href={link(`/resources?audience=${a.slug}`)}>{a.label}</a></li>)}
          </ul>
        </div>
      </div>
      <p class="browse-all">
        <a href={link('/resources')}>See all organizations <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    padding-block: clamp(2rem, 1.5rem + 4vw, 4rem);
    max-width: 820px;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sage-700);
    margin-bottom: 0.7rem;
  }
  .hero-lead {
    margin-top: 0.8rem;
    max-width: 52ch;
  }
  .hero-emergency {
    margin-top: 1.3rem;
    font-size: 1rem;
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--alert-border);
    border-left: 4px solid var(--alert);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    max-width: 640px;
  }
  .hero-emergency a {
    font-weight: 700;
    color: var(--alert-dark);
  }

  .home-h {
    font-size: clamp(1.35rem, 1.2rem + 0.8vw, 1.75rem);
    margin-bottom: 1rem;
  }
  .home-h-sub {
    margin-top: 2.5rem;
  }

  .situations,
  .needs,
  .browse-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .situations {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 900px) {
    .situations {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .situation {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.15rem 1.1rem;
    border-radius: var(--radius);
    border: 2px solid var(--blue-200);
    background: var(--blue-50);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .situation:hover {
    border-color: var(--blue-500);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .situation-urgent {
    border-color: var(--alert-border);
    background: var(--alert-bg);
  }
  .situation-urgent:hover {
    border-color: var(--alert);
  }
  .situation-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    background: var(--white);
    color: var(--blue-700);
  }
  .situation-urgent .situation-icon {
    color: var(--alert);
  }
  .situation-text {
    flex: 1;
    min-width: 0;
  }
  .situation-title {
    display: block;
    font-weight: 700;
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--blue-900);
  }
  .situation-urgent .situation-title {
    color: var(--alert-dark);
  }
  .situation-sub {
    display: block;
    margin-top: 0.25rem;
    color: var(--slate);
    font-size: 0.95rem;
  }
  .situation-arrow {
    flex: none;
    color: var(--slate-light);
  }

  .needs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 0.7rem;
  }
  .need {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    height: 100%;
    min-height: 60px;
    padding: 0.8rem 1rem;
    background: var(--white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--blue-900);
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .need:hover {
    border-color: var(--sage-500);
    box-shadow: var(--shadow-sm);
    color: var(--blue-900);
  }
  .need-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 11px;
    background: var(--sage-50);
    color: var(--sage-700);
  }

  .unsure {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .unsure h2 {
    font-size: 1.35rem;
  }
  .unsure p {
    margin-top: 0.35rem;
    color: var(--slate);
    max-width: 52ch;
  }
  .unsure-btn {
    min-height: 48px;
  }

  .searchbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-full);
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    max-width: 640px;
  }
  .searchbar:focus-within {
    border-color: var(--blue-500);
    box-shadow: var(--shadow);
  }
  .searchbar-icon {
    color: var(--slate-light);
    flex: none;
  }
  .searchbar input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: transparent;
    padding: 0.55rem 0;
  }
  .searchbar .btn {
    flex: none;
  }

  .browse {
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem 3rem;
  }
  @media (min-width: 760px) {
    .browse {
      grid-template-columns: 1fr 1fr;
    }
  }
  .browse-h {
    font-size: 1rem;
    margin-bottom: 0.6rem;
  }
  .browse-list {
    columns: 2 200px;
    column-gap: 1.5rem;
  }
  .browse-list li {
    padding-block: 0.3rem;
    break-inside: avoid;
  }
  .browse-all {
    margin-top: 1.5rem;
  }
  .browse-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }
</style>
