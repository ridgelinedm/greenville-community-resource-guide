---
/**
 * Homepage = "what is happening?" first, directory second. The hero IS the
 * picker: situations as an index, needs as a sentence, and the guided
 * walkthrough for anyone who isn't sure. What the guide is comes after.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { RESOURCES } from '../data/resources';
import { SITE_NAME, SITE_DESCRIPTION, AREA } from '../consts';
import { link, absolute } from '../utils/url';

const situations = [
  { href: '/get-help-now', title: 'I need help right now', text: 'Crisis lines, a safe place tonight', urgent: true },
  { href: '/someone-i-love-is-in-jail', title: 'Someone I love was arrested or is in jail', text: 'Find them and reach them' },
  { href: '/reentry-support', title: "I'm coming home, or just got out", text: 'ID, a place to stay, work' },
  { href: '/housing-shelter', title: 'I need a place to stay', text: 'Shelters tonight, help with housing' },
  { href: '/food-assistance', title: 'I need food', text: 'Meals today, groceries this week' },
];

// Read as one sentence: "I need … rent money · a doctor · …"
const needs = [
  { href: '/financial-assistance', label: 'help with rent or bills' },
  { href: '/medical-care', label: 'a doctor or medicine' },
  { href: '/mental-health-recovery', label: 'someone to talk to' },
  { href: '/mental-health-recovery', label: 'to stop drinking or using' },
  { href: '/legal-aid', label: 'legal help' },
  { href: '/transportation', label: 'a ride' },
  { href: '/education', label: 'school or job training' },
];

const audiences = [
  {
    title: 'When someone you love is locked up',
    text: 'Find out where they are, set up calls, mail and visits, and get help for you and the kids.',
    action: 'Start with jail and family help',
    href: '/someone-i-love-is-in-jail',
  },
  {
    title: "When you're coming home",
    text: 'Get your ID and papers back, find a place to stay and food, and find work and people who get it.',
    action: 'See coming-home help',
    href: '/reentry-support',
  },
  {
    title: 'When money, health or housing gets hard',
    text: 'Rent, bills and food. Doctors and someone to talk to. Free legal help.',
    action: 'Browse every organization',
    href: '/resources',
  },
];

const origin = Astro.site?.origin ?? '';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absolute(origin, '/'),
    description: SITE_DESCRIPTION,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: absolute(origin, '/resources?q={search_term_string}'),
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: absolute(origin, '/'),
    description: SITE_DESCRIPTION,
    areaServed: { '@type': 'AdministrativeArea', name: AREA },
  },
];
---

<Base title={`${SITE_NAME}: Find help in Greenville, SC and the Upstate`} bareTitle jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero-grid">
      <div class="hero-intro">
        <p class="hero-where">
          <Icon name="map-pin" size={18} />
          Free help in <strong>Greenville, South Carolina</strong> and the Upstate
        </p>
        <h1 id="hero-h" class="hero-h">What's happening?</h1>
        <p class="hero-lead">Pick the one that sounds like you. We'll show you who can help and what to do next.</p>
        <p class="hero-danger">
          In danger? Call <a href="tel:911">911</a>. Thinking about hurting yourself? Call or text <a href="tel:988">988</a>.
        </p>
      </div>

      <div class="hero-pick">
        <ol class="index">
          {
            situations.map((s, i) => (
              <li style={`--i:${i}`}>
                <a href={link(s.href)} class:list={['index-row', { 'index-urgent': s.urgent }]}>
                  <span class="index-t">{s.title}</span>
                  <span class="index-s">{s.text}</span>
                  <span class="index-go" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
                </a>
              </li>
            ))
          }
          <li style={`--i:${situations.length}`}>
            <button type="button" class="index-row index-guide" data-guide-open aria-haspopup="dialog">
              <span class="index-t">I'm not sure what I need</span>
              <span class="index-s">Answer 3 quick questions</span>
              <span class="index-go" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
            </button>
          </li>
        </ol>

        <p class="needline">
          <span class="needline-lead">Or, I need</span>
          {
            needs.map((n, i) => (
              <>
                <a href={link(n.href)}>{n.label}</a>
                {i < needs.length - 1 && <span class="needline-sep" aria-hidden="true">/</span>}
              </>
            ))
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section about-guide" aria-labelledby="what-h">
    <div class="container split" data-reveal>
      <h2 id="what-h" class="split-h">
        A free guide to getting help in Greenville and the Upstate, written in plain words.
      </h2>
      <div class="split-body">
        <p class="lead">
          We've gathered {RESOURCES.length} local organizations, from shelters and food pantries to free
          clinics and legal aid, and put them in order by what you're going through. You don't need an
          account, and it costs nothing.
        </p>
        <ol class="howto">
          <li><span><b>Say what's happening.</b> In your own words, not a form.</span></li>
          <li><span><b>See who can help.</b> Places that fit, and what they can do for you.</span></li>
          <li><span><b>Make one call.</b> Every page ends with a single next step and what to ask.</span></li>
        </ol>
        <a href={link('/about')} class="tlink">How we check this information</a>
      </div>
    </div>
  </section>

  <section class="section who" aria-labelledby="who-h">
    <div class="container" data-reveal>
      <h2 id="who-h" class="who-h">For anyone in the middle of something hard, and the people trying to help them.</h2>
      <div class="who-cols">
        {
          audiences.map((a) => (
            <article class="who-col">
              <h3>{a.title}</h3>
              <div>
                <p>{a.text}</p>
                <a href={link(a.href)} class="tlink">{a.action}</a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight find" aria-labelledby="search-h">
    <div class="container">
      <h2 id="search-h">Know what you're looking for?</h2>
      <form class="searchbar" action={link('/resources')} method="get" role="search">
        <label for="home-q" class="sr-only">Search by need or organization name</label>
        <Icon name="search" size={22} class="searchbar-icon" />
        <input id="home-q" name="q" type="search" placeholder="Try “shelter” or “Triune”" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>
  </section>
</Base>
