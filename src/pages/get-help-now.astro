---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CrisisLines from '../components/CrisisLines.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { link } from '../utils/url';

const quick = [
  {
    slug: 'food-assistance',
    icon: 'food',
    title: 'I need food today',
    text: 'Soup kitchens and pantries with same-day meals and groceries.',
  },
  {
    slug: 'housing-shelter',
    icon: 'housing',
    title: 'I need shelter tonight',
    text: 'Emergency shelters and day shelters. Call early — beds fill fast.',
  },
  {
    slug: 'medical-care',
    icon: 'medical',
    title: 'I need medical care',
    text: 'Free clinics for the uninsured. No insurance required.',
  },
  {
    slug: 'mental-health-recovery',
    icon: 'mental-health',
    title: 'I need someone to talk to',
    text: 'Counseling, crisis support, and recovery help.',
  },
];

const title = 'Get help right now in Greenville, SC';
const description =
  'Emergency hotlines and same-day help in Greenville County: shelter tonight, food today, crisis lines, and free clinics. Call now — help is available 24/7.';
---

<Base title={title} description={description}>
  <div class="container page-top">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Get help now' }]} />
  </div>

  <section class="journey-head">
    <div class="container container-narrow">
      <h1>Get help right now</h1>
      <p class="lead">
        You are not alone, and help is available today. If you are in immediate danger, call
        <a href="tel:911"><strong>911</strong></a>. Otherwise, start with one of the hotlines
        below. They are free, confidential, and answered 24/7.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container container-narrow">
      <CrisisLines />
    </div>
  </section>

  <section class="section-tight bg-soft">
    <div class="container container-narrow">
      <SectionHeader
        title="What do you need most right now?"
        text="Each one opens a short list of places that can help today."
      />
      <ul class="index">
        {
          quick.map((q, i) => (
            <li style={`--i:${i}`}>
              <a href={link(`/${q.slug}`)} class="index-row">
                <span class="index-t">{q.title}</span>
                <span class="index-s">{q.text}</span>
                <span class="index-go" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <CtaBand title="Still not sure? One call can sort it out." secondary={null} />
    </div>
  </section>
</Base>
